<?xml version="1.0" ?>
<!--
  Valtoryn Reference Warehouse Simulation World
  Target: Gazebo Harmonic (gz-sim 8) / ROS 2 Jazzy Jalisco
  Coordinates: Right-handed Z-up (REP-103)
  Dimensions: 20m x 16m with 3 longitudinal aisles and 2 lateral transit cross-aisles
-->
<sdf version="1.9">
  <world name="warehouse">

    <!-- Physics Engine Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor / Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>24 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>24 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.72 1</ambient>
            <diffuse>0.7 0.7 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Perimeter Walls -->
    <model name="warehouse_walls">
      <static>true</static>
      <!-- North Wall -->
      <link name="wall_north">
        <pose>0 8 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material>
        </visual>
      </link>
      <!-- South Wall -->
      <link name="wall_south">
        <pose>0 -8 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>20 0.3 3.0</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material>
        </visual>
      </link>
      <!-- East Wall -->
      <link name="wall_east">
        <pose>10 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.3 16 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.3 16 3.0</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material>
        </visual>
      </link>
      <!-- West Wall -->
      <link name="wall_west">
        <pose>-10 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.3 16 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.3 16 3.0</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Rack Rows (Aisles between Y=3.5 and Y=1.2, Y=1.2 and Y=-1.2, Y=-1.2 and Y=-3.5) -->
    <!-- Storage Rack Row 1 (North) -->
    <model name="rack_row_1">
      <static>true</static>
      <pose>0 4.2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>9.0 0.9 2.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>9.0 0.9 2.5</size></box></geometry>
          <material><ambient>0.2 0.35 0.55 1</ambient><diffuse>0.2 0.35 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Rack Row 2 (North Central) -->
    <model name="rack_row_2">
      <static>true</static>
      <pose>0 1.6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>9.0 0.9 2.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>9.0 0.9 2.5</size></box></geometry>
          <material><ambient>0.2 0.35 0.55 1</ambient><diffuse>0.2 0.35 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Rack Row 3 (South Central) -->
    <model name="rack_row_3">
      <static>true</static>
      <pose>0 -1.6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>9.0 0.9 2.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>9.0 0.9 2.5</size></box></geometry>
          <material><ambient>0.2 0.35 0.55 1</ambient><diffuse>0.2 0.35 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Storage Rack Row 4 (South) -->
    <model name="rack_row_4">
      <static>true</static>
      <pose>0 -4.2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>9.0 0.9 2.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>9.0 0.9 2.5</size></box></geometry>
          <material><ambient>0.2 0.35 0.55 1</ambient><diffuse>0.2 0.35 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Loading / Pickup Station 1 (West Hall, North) -->
    <model name="station_pick_1">
      <static>true</static>
      <pose>-7.0 4.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="marking">
          <geometry><box><size>1.6 1.6 0.02</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Loading / Pickup Station 2 (West Hall, South) -->
    <model name="station_pick_2">
      <static>true</static>
      <pose>-7.0 -4.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="marking">
          <geometry><box><size>1.6 1.6 0.02</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dropoff / Packaging Station 1 (East Hall, North) -->
    <model name="station_drop_1">
      <static>true</static>
      <pose>7.0 4.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="marking">
          <geometry><box><size>1.6 1.6 0.02</size></box></geometry>
          <material><ambient>0.1 0.7 0.3 1</ambient><diffuse>0.1 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dropoff / Packaging Station 2 (East Hall, South) -->
    <model name="station_drop_2">
      <static>true</static>
      <pose>7.0 -4.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="marking">
          <geometry><box><size>1.6 1.6 0.02</size></box></geometry>
          <material><ambient>0.1 0.7 0.3 1</ambient><diffuse>0.1 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static Obstacle 1: Pallet Stack in Central Aisle -->
    <model name="pallet_stack_static">
      <static>true</static>
      <pose>0.5 0.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.9 0.9 0.9</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.9 0.9 0.9</size></box></geometry>
          <material><ambient>0.7 0.45 0.25 1</ambient><diffuse>0.7 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static Obstacle 2: Staging Crate in North Staging Area -->
    <model name="staging_crate_static">
      <static>true</static>
      <pose>-2.5 6.2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.8 0.8 0.7</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.8 0.7</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Dynamic Obstacle Model with Velocity Control Plugin -->
    <model name="moving_obstacle">
      <pose>6.0 0.0 0.5 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.2</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.2</iyy><iyz>0</iyz><izz>0.2</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.7 0.7 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.7 0.7 1.0</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    </model>

  </world>
</sdf>


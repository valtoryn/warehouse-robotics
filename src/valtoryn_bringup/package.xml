<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>valtoryn_bringup</name>
  <version>0.1.0</version>
  <description>
    Valtoryn Warehouse Robotics reference AMR simulation and autonomous navigation bring-up.
    Provides headless and GUI Gazebo Harmonic world launches, robot spawning, ros_gz bridging,
    ros2_control activation, SLAM mapping, and Nav2 navigation pipelines.
  </description>
  <maintainer email="bhogesara.ram23@gmail.com">Ram Bhogesara</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>robot_state_publisher</depend>
  <depend>controller_manager</depend>
  <depend>diff_drive_controller</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>gz_ros2_control</depend>
  <depend>nav2_bringup</depend>
  <depend>slam_toolbox</depend>
  <depend>valtoryn_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>


<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>valtoryn_task_bt</name>
  <version>0.2.0</version>
  <description>
    Valtoryn warehouse task behavior trees (BehaviorTree.CPP v4).
    Provides executable BT action nodes for Nav2 NavigateToPose, simulated docking,
    and explicit non-functional payload material handling stubs.
  </description>
  <maintainer email="bhogesara.ram23@gmail.com">Ram Bhogesara</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>behaviortree_cpp</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>valtoryn_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>valtoryn_lifecycle</name>
  <version>0.1.0</version>
  <description>
    Valtoryn subsystem lifecycle manager and diagnostics supervisor.
    Orchestrates Tier 0/Tier 1 lifecycle transitions and health monitoring
    per docs/architecture/SYSTEM_ARCHITECTURE.md section 6.
  </description>
  <maintainer email="bhogesara.ram23@gmail.com">Ram Bhogesara</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>lifecycle_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>valtoryn_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
